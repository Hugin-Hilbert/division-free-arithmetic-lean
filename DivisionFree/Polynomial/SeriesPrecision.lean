import DivisionFree.Polynomial.VectorResize
import Mathlib.Algebra.Polynomial.Div

/-! Algebraic operations on truncated polynomial precision. -/

namespace DivisionFree.PolynomialArithmetic

/-- Congruence modulo the precision ideal generated by `X^q`. -/
def precisionCongruent {R : Type*} [CommRing R] (q : ℕ)
    (p r : Polynomial R) : Prop := (Polynomial.X : Polynomial R) ^ q ∣ p - r

/-- A precision congruence is equivalent to equality of the canonical
remainders modulo `X^q`. -/
theorem precisionCongruent_iff_modByMonic_eq {R : Type*} [CommRing R]
    (q : ℕ) (p r : Polynomial R) :
    precisionCongruent q p r ↔
      p %ₘ (Polynomial.X ^ q) = r %ₘ (Polynomial.X ^ q) := by
  rw [precisionCongruent]
  constructor
  · intro h
    exact Polynomial.modByMonic_eq_of_dvd_sub (Polynomial.monic_X_pow q) h
  · intro h
    rw [← Polynomial.modByMonic_add_div p (Polynomial.X ^ q),
      ← Polynomial.modByMonic_add_div r (Polynomial.X ^ q), h]
    convert dvd_mul_right (Polynomial.X ^ q)
      ((p /ₘ (Polynomial.X ^ q)) - (r /ₘ (Polynomial.X ^ q))) using 1
    ring

/-- Low coefficients of `p` below precision `h`. -/
noncomputable def precisionLow {R : Type*} [CommRing R] (h : ℕ) (p : Polynomial R) : Polynomial R :=
  p %ₘ (Polynomial.X ^ h)

/-- The coefficients at positions `h` through `q-1`, reindexed from zero. -/
noncomputable def precisionTail {R : Type*} [CommRing R] (h q : ℕ) (p : Polynomial R) : Polynomial R :=
  (p /ₘ (Polynomial.X ^ h)) %ₘ (Polynomial.X ^ (q - h))

/-- Division by a power of `X` shifts coefficients down by its exponent. -/
theorem coeff_divByMonic_X_pow {R : Type*} [CommRing R]
    (p : Polynomial R) (h k : ℕ) :
    (p /ₘ (Polynomial.X ^ h)).coeff k = p.coeff (h + k) := by
  have hdiv := congrArg (fun z : Polynomial R => z.coeff (h + k))
    (Polynomial.modByMonic_add_div p (Polynomial.X ^ h))
  rw [Polynomial.coeff_add, Polynomial.coeff_X_pow_mul'] at hdiv
  rw [modByMonic_X_pow_coeff] at hdiv
  simp only [if_neg (show ¬ h + k < h by omega),
    if_pos (show h ≤ h + k by omega), Nat.add_sub_cancel_left] at hdiv
  simpa using hdiv

theorem precisionLow_coeff {R : Type*} [CommRing R]
    (h : ℕ) (p : Polynomial R) (k : ℕ) :
    (precisionLow h p).coeff k = if k < h then p.coeff k else 0 := by
  exact modByMonic_X_pow_coeff p h k

theorem precisionTail_coeff {R : Type*} [CommRing R]
    {h q : ℕ} (p : Polynomial R) (k : ℕ) :
    (precisionTail h q p).coeff k =
      if k < q - h then p.coeff (h + k) else 0 := by
  rw [precisionTail, modByMonic_X_pow_coeff]
  split_ifs with hk
  · rw [coeff_divByMonic_X_pow]
  · rfl

/-- Split the truncation at `q` into its first `h` coefficients and the
reindexed remaining coefficients. -/
theorem precision_split {R : Type*} [CommRing R]
    {h q : ℕ} (hhq : h ≤ q) (p : Polynomial R) :
    p %ₘ (Polynomial.X ^ q) =
      precisionLow h p + Polynomial.X ^ h * precisionTail h q p := by
  apply Polynomial.ext
  intro k
  rw [Polynomial.coeff_add, Polynomial.coeff_X_pow_mul',
    modByMonic_X_pow_coeff, precisionLow_coeff, precisionTail_coeff]
  by_cases hkq : k < q
  · by_cases hkh : k < h
    · simp [hkq, hkh]
    · have hhk : h ≤ k := Nat.le_of_not_gt hkh
      simp [hkq, hkh, hhk, show k - h < q - h by omega,
        Nat.add_sub_of_le hhk]
  · have hqk : q ≤ k := Nat.le_of_not_gt hkq
    have hhk : h ≤ k := le_trans hhq hqk
    have hkh : ¬ k < h := by omega
    simp [hkq, hkh, hhk, show ¬ k - h < q - h by omega]

/-- If the low block is zero, the original truncation is the shifted tail. -/
theorem precision_split_low_eq_zero {R : Type*} [CommRing R]
    {h q : ℕ} (hhq : h ≤ q) (p : Polynomial R)
    (hlow : precisionLow h p = 0) :
    p %ₘ (Polynomial.X ^ q) = Polynomial.X ^ h * precisionTail h q p := by
  rw [precision_split hhq p, hlow, zero_add]

theorem precisionLow_eq_zero_iff_dvd {R : Type*} [CommRing R]
    (h : ℕ) (p : Polynomial R) :
    precisionLow h p = 0 ↔ (Polynomial.X : Polynomial R) ^ h ∣ p :=
  Polynomial.modByMonic_eq_zero_iff_dvd (Polynomial.monic_X_pow h)

private theorem precisionTail_shift_remainder {R : Type*} [CommRing R]
    {h q : ℕ} (hhq : h ≤ q) (p : Polynomial R) :
    (Polynomial.X ^ h * precisionTail h q p) %ₘ (Polynomial.X ^ q) =
      Polynomial.X ^ h * precisionTail h q p := by
  apply Polynomial.ext
  intro k
  by_cases hkq : k < q
  · rw [modByMonic_X_pow_coeff]
    simp [hkq]
  · have hqk : q ≤ k := Nat.le_of_not_gt hkq
    have hhk : h ≤ k := le_trans hhq hqk
    have htail : ¬ k - h < q - h := by omega
    rw [modByMonic_X_pow_coeff]
    simp only [hkq, ↓reduceIte, Polynomial.coeff_X_pow_mul', hhk]
    rw [precisionTail_coeff]
    simp [htail]

/-- Divisibility by `X^h` makes the shifted, truncated high tail reconstruct
`p` modulo `X^q`. -/
theorem precision_tail_reconstruct {R : Type*} [CommRing R]
    {h q : ℕ} (hhq : h ≤ q) (p : Polynomial R)
    (hp : (Polynomial.X : Polynomial R) ^ h ∣ p) :
    precisionCongruent q p (Polynomial.X ^ h * precisionTail h q p) := by
  apply (precisionCongruent_iff_modByMonic_eq q p _).2
  rw [precision_split_low_eq_zero hhq p ((precisionLow_eq_zero_iff_dvd h p).2 hp)]
  rw [precisionTail_shift_remainder hhq p]

/-- Shifting a polynomial by `X^h` places its coefficient `k` at `h+k`. -/
theorem coeff_shift_X_pow {R : Type*} [CommRing R]
    (h : ℕ) (p : Polynomial R) (k : ℕ) :
    (Polynomial.X ^ h * p).coeff (h + k) = p.coeff k := by
  rw [Polynomial.coeff_X_pow_mul']
  simp

/-- Polynomial concatenation of a low vector and a high vector. -/
theorem vectorPolynomial_split {R : Type*} [CommRing R]
    {h q : ℕ} (hhq : h ≤ q)
    (low : Fin h → R) (high : Fin (q - h) → R) :
    vectorPolynomial q (fun i : Fin q =>
      if hi : i.val < h then low ⟨i.val, hi⟩
      else high ⟨i.val - h, by have := i.isLt; omega⟩) =
      vectorPolynomial h low + Polynomial.X ^ h * vectorPolynomial (q - h) high := by
  apply Polynomial.ext
  intro k
  by_cases hkq : k < q
  · rw [vectorPolynomial_coeff_of_lt q k _ hkq, Polynomial.coeff_add,
      Polynomial.coeff_X_pow_mul']
    by_cases hkh : k < h
    · rw [vectorPolynomial_coeff_of_lt h k low hkh]
      simp [hkh]
    · have hhk : h ≤ k := Nat.le_of_not_gt hkh
      have hkh' : k - h < q - h := by omega
      rw [vectorPolynomial_coeff_of_lt (q - h) (k - h) high hkh']
      simp [hkh, vectorPolynomial_coeff_eq_zero_of_ge h k low hhk]
  · have hqk : q ≤ k := Nat.le_of_not_gt hkq
    have hhk : h ≤ k := le_trans hhq hqk
    have hhk' : q - h ≤ k - h := by omega
    rw [vectorPolynomial_coeff_eq_zero_of_ge q k _ hqk,
      Polynomial.coeff_add, Polynomial.coeff_X_pow_mul',
      vectorPolynomial_coeff_eq_zero_of_ge h k low hhk,
      vectorPolynomial_coeff_eq_zero_of_ge (q - h) (k - h) high hhk']
    simp [hhk]

end DivisionFree.PolynomialArithmetic
